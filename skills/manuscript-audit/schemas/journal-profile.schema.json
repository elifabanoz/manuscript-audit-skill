{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JournalProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["issn", "title", "publisher", "article_types", "rules", "sources"],
  "properties": {
    "issn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{3}[0-9X]$" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "openalex_source_id": { "type": "string", "minLength": 1 },
    "article_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": { "$ref": "#/$defs/quotedSource" },
    "ai_policy": { "$ref": "#/$defs/quotedSource" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "kind", "quote", "source_ref"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["deterministic", "semantic"] },
          "quote": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "op", "value"],
            "properties": {
              "metric": { "enum": ["abstract_words", "main_text_words", "keyword_count", "heading_count"] },
              "op": { "enum": ["<", "<=", "=", ">=", ">"] },
              "value": { "type": "number" },
              "heading": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              { "if": { "properties": { "metric": { "const": "heading_count" } } }, "then": { "required": ["heading"] }, "else": { "not": { "required": ["heading"] } } }
            ]
          },
          "requirement": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "deterministic" } } }, "then": { "required": ["check"], "not": { "required": ["requirement"] } } },
          { "if": { "properties": { "kind": { "const": "semantic" } } }, "then": { "required": ["requirement"], "not": { "required": ["check"] } } }
        ]
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "retrieved_at", "sha256", "path"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://.+" },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "quotedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "source_ref"],
      "properties": {
        "quote": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
